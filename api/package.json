{
  "name": "@kiyoyo/commerce-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "test": "tsx --test test/*.test.ts",
    "pospal:verify": "tsx scripts/pospal-verify.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@google-cloud/storage": "^8.4.0",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
