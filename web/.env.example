# dev works with the checked-in development defaults. Set every value explicitly
# for staging/prod so a build can never silently point at kiyoyo-dev.
NEXT_PUBLIC_KIYOYO_ENV=dev
NEXT_PUBLIC_API_BASE_URL=https://kiyoyo-dev-api-kwlb74l7uq-ew.a.run.app
NEXT_PUBLIC_MAPS_BROWSER_KEY=replace-with-environment-browser-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kiyoyo
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-environment-firebase-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kiyoyo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-environment-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kiyoyo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=386290495601
